# Tributary container environment — copy to the repo root as `.env`
# (cp deploy/.env.example .env). That file is gitignored; NEVER commit it.
# docker-compose.yml loads it via `env_file: .env`.
# Every variable below is read by the binary at run time — none are baked
# into the image.

# REQUIRED — master key for provider-key envelope encryption (64 hex
# chars). The quickstart appends it after copying this file:
#   echo "TRIBUTARY_MASTER_KEY=$(openssl rand -hex 32)" >> .env
# Losing it loses every stored provider key; changing it invalidates them.
#TRIBUTARY_MASTER_KEY=

# Database. Default is the container's SQLite volume file — leave unset
# for single-container deploys. Postgres example for compose stacks:
# postgres://user:pass@postgres:5432/tributary
#TRIBUTARY_DATABASE_URL=sqlite:///data/tributary.db

# Bind address INSIDE the container. Keep 0.0.0.0 so Docker's port map can
# reach it; publish/override the HOST port in docker-compose.yml instead.
#TRIBUTARY_BIND=0.0.0.0:8080

# Comma-separated CIDR list of reverse proxies you control (e.g.
# 172.18.0.0/16 for the compose network, or your nginx host). X-Forwarded-For
# is honored ONLY from these; when unset, client IP = raw socket address.
# IP-derived controls (allowlists, sharing detection) are only sound with
# this set behind a proxy you control (A-019).
#TRIBUTARY_TRUSTED_PROXIES=

# Comma-separated default model allowlist for new pools and the fallback
# for GET /v1/models on unrestricted pools (default: gpt-4o-mini).
# Add your Gemini model when a pool serves gemini traffic, e.g.:
#   TRIBUTARY_MODELS=gpt-4o-mini,gemini-3.8-flash
# (verify the current gemini model id on your endpoint — see
#  deploy/README.md "Provider keys"; ids drift over time.)
#TRIBUTARY_MODELS=gpt-4o-mini

# "json" for structured JSON logs (recommended for log aggregation);
# unset/any other value gives human-readable logs.
#TRIBUTARY_LOG_FORMAT=json

# --- Email alerts for leak detection (M4). All five or none — an
# incomplete set falls back to logging the alert on the container.
#TRIBUTARY_SMTP_HOST=smtp.example.com
#TRIBUTARY_SMTP_PORT=587
#TRIBUTARY_SMTP_USERNAME=
#TRIBUTARY_SMTP_PASSWORD=
#TRIBUTARY_SMTP_FROM=tributary@example.com

# --- Optional GeoLite2-Country database path (.mmdb) for impossible-travel
# country lookups. Only active when the image was compiled with the geoip
# feature; harmless otherwise.
#TRIBUTARY_GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb
