# Environment / secrets — never commit
.env
.env.*
# Template ships (README step 1 copies it) — stranger-run catch
# (2026-10-24): .env.* also hid deploy/.env.example from clones.
!deploy/.env.example

# Node / pnpm
node_modules/
.next/
out/
*.tsbuildinfo
.pnpm-store/

# Rust build artifacts
/target

# Anchor/Solana build artifacts (M8) — anchor runs inside programs/pool
programs/pool/target/
programs/pool/.anchor/
# Standalone soak client's build dir (its Cargo.lock IS committed — pin it)
scripts/devnet-soak/target/
# Devnet operational keypairs — pubkeys live in deploy/devnet-m8.json;
# the keypairs themselves are NEVER committed (AGENTS secrets rule).
target/m8-keys/

# Internal notes — intentionally untracked; NEVER `git add -f`
STRATEGY.md
M3-FINAL-REPORT.md
# Playwright E2E artifacts (J6) — reports/screenshots are local evidence
apps/dashboard/test-results/
apps/dashboard/playwright-report/
scripts/__pycache__/
